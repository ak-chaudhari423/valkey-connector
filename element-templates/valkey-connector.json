{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "valkey-connector",
  "id": "io.camunda.valkey.connector.v1",
  "version": 5,
  "description": "Connect to Valkey in standalone or cluster mode and perform key-value operations.",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "connection",
      "label": "Connection"
    },
    {
      "id": "authentication",
      "label": "Authentication"
    },
    {
      "id": "operation",
      "label": "Operation"
    },
    {
      "id": "output",
      "label": "Response mapping"
    },
    {
      "id": "errors",
      "label": "Error handling"
    },
    {
      "id": "retries",
      "label": "Retries"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.camunda:valkey:1",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "type"
      }
    },
    {
      "id": "connectionType",
      "label": "Connection Type",
      "type": "Dropdown",
      "value": "STANDALONE",
      "group": "connection",
      "choices": [
        {
          "name": "Standalone",
          "value": "STANDALONE"
        },
        {
          "name": "Cluster",
          "value": "CLUSTER"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "connectionType"
      }
    },
    {
      "id": "host",
      "label": "Host",
      "type": "String",
      "group": "connection",
      "description": "Valkey hostname or IP address.",
      "value": "localhost",
      "binding": {
        "type": "zeebe:input",
        "name": "host"
      },
      "condition": {
        "property": "connectionType",
        "equals": "STANDALONE"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Port",
      "type": "String",
      "group": "connection",
      "description": "Valkey port.",
      "value": "6379",
      "binding": {
        "type": "zeebe:input",
        "name": "port"
      },
      "condition": {
        "property": "connectionType",
        "equals": "STANDALONE"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Cluster Nodes",
      "type": "String",
      "group": "connection",
      "description": "Comma-separated Valkey cluster nodes. Example: node1:6379,node2:6379,node3:6379",
      "binding": {
        "type": "zeebe:input",
        "name": "clusterNodes"
      },
      "condition": {
        "property": "connectionType",
        "equals": "CLUSTER"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Username",
      "type": "String",
      "group": "authentication",
      "description": "Valkey ACL username. Optional.",
      "binding": {
        "type": "zeebe:input",
        "name": "username"
      }
    },
    {
      "label": "Password",
      "type": "String",
      "group": "authentication",
      "description": "Valkey password.",
      "binding": {
        "type": "zeebe:input",
        "name": "password"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "SSL/TLS",
      "type": "Boolean",
      "group": "authentication",
      "value": false,
      "binding": {
        "type": "zeebe:input",
        "name": "ssl"
      }
    },
    {
      "id": "operation",
      "label": "Operation",
      "type": "Dropdown",
      "group": "operation",
      "value": "get",
      "choices": [
        {
          "name": "Get Value (GET)",
          "value": "get"
        },
        {
          "name": "Set Value (SET)",
          "value": "set"
        },
        {
          "name": "Delete Key (DELETE)",
          "value": "delete"
        },
        {
          "name": "Check Key Exists (EXISTS)",
          "value": "exists"
        },
        {
          "name": "Set Key Expiration (EXPIRE)",
          "value": "expire"
        },
        {
          "name": "Get Remaining Expiration (TTL)",
          "value": "ttl"
        },
        {
          "name": "Increment Value by 1 (INCR)",
          "value": "incr"
        },
        {
          "name": "Decrement Value by 1 (DECR)",
          "value": "decr"
        },
        {
          "name": "Get Hash Field (HGET)",
          "value": "hget"
        },
        {
          "name": "Set Hash Field (HSET)",
          "value": "hset"
        },
        {
          "name": "Get All Hash Fields (HGETALL)",
          "value": "hgetall"
        },
        {
          "name": "Delete Hash Field (HDEL)",
          "value": "hdel"
        },
        {
          "name": "Add to List from Left (LPUSH)",
          "value": "lpush"
        },
        {
          "name": "Add to List from Right (RPUSH)",
          "value": "rpush"
        },
        {
          "name": "Remove First List Item (LPOP)",
          "value": "lpop"
        },
        {
          "name": "Remove Last List Item (RPOP)",
          "value": "rpop"
        },
        {
          "name": "Add Member to Set (SADD)",
          "value": "sadd"
        },
        {
          "name": "Remove Member from Set (SREM)",
          "value": "srem"
        },
        {
          "name": "Get All Set Members (SMEMBERS)",
          "value": "smembers"
        },
        {
          "name": "Check Set Membership (SISMEMBER)",
          "value": "sismember"
        },
        {
          "name": "Scan Keys (SCAN)",
          "value": "scan"
        },
        {
          "name": "Get Key Data Type (TYPE)",
          "value": "type"
        },
        {
          "name": "Rename Key (RENAME)",
          "value": "rename"
        },
        {
          "name": "Increment Value by Amount (INCRBY)",
          "value": "incrby"
        },
        {
          "name": "Decrement Value by Amount (DECRBY)",
          "value": "decrby"
        },
        {
          "name": "Publish Message (PUBLISH)",
          "value": "publish"
        },
        {
          "name": "Subscribe to Channel (SUBSCRIBE)",
          "value": "subscribe"
        }
      ],
      "constraints": {
        "notEmpty": true
      },
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "operation"
      }
    },
    {
      "id": "key",
      "label": "Key",
      "type": "String",
      "group": "operation",
      "description": "Valkey key.",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "key"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "get",
          "set",
          "delete",
          "exists",
          "expire",
          "ttl",
          "incr",
          "decr",
          "hget",
          "hset",
          "hgetall",
          "hdel",
          "lpush",
          "rpush",
          "lpop",
          "rpop",
          "sadd",
          "srem",
          "smembers",
          "sismember",
          "type",
          "rename",
          "incrby",
          "decrby"
        ]
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "newKey",
      "label": "newKey",
      "type": "String",
      "group": "operation",
      "feel": "optional",
      "description": "Enter New Key to Rename",
      "binding": {
        "type": "zeebe:input",
        "name": "newKey"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operation",
        "equals": "rename"
      }
    },
    {
      "id": "value",
      "label": "Value",
      "type": "String",
      "group": "operation",
      "feel": "optional",
      "description": "Value to store. Used for SET.",
      "binding": {
        "type": "zeebe:input",
        "name": "value"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "set",
          "hset",
          "lpush",
          "rpush",
          "sadd",
          "srem",
          "sismember"
        ]
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "expirationSeconds",
      "label": "Expiration (seconds)",
      "type": "Number",
      "group": "operation",
      "feel": "optional",
      "description": "Optional expiration time in seconds. The key will automatically expire after this duration.",
      "binding": {
        "type": "zeebe:input",
        "name": "expirationSeconds"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "set",
          "expire"
        ]
      }
    },
    {
      "id": "hashField",
      "label": "Field",
      "type": "String",
      "group": "operation",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "field"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "hset",
          "hdel"
        ]
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "amount",
      "label": "amount",
      "type": "String",
      "group": "operation",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "amount"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "incrby",
          "decrby"
        ]
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "channel",
      "label": "Channel",
      "feel": "optional",
      "type": "String",
      "group": "operation",
      "description": "Valkey Pub/Sub channel to subscribe to.",
      "binding": {
        "type": "zeebe:input",
        "name": "channel"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "publish",
          "subscribe"
        ]
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "message",
      "label": "Message",
      "type": "Text",
      "group": "operation",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "message"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "publish",
          "subscribe"
        ]
      }
    },
    {
      "id": "scanPattern",
      "label": "Pattern",
      "type": "String",
      "group": "operation",
      "feel": "optional",
      "description": "Optional pattern such as user:*",
      "binding": {
        "type": "zeebe:input",
        "name": "pattern"
      },
      "condition": {
        "property": "operation",
        "equals": "scan"
      }
    },
    {
      "id": "scanCursor",
      "label": "Cursor",
      "type": "String",
      "group": "operation",
      "value": "0",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "cursor"
      },
      "condition": {
        "property": "operation",
        "equals": "scan"
      }
    },
    {
      "id": "count",
      "label": "Count",
      "type": "Number",
      "group": "operation",
      "value": 100,
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "count"
      },
      "condition": {
        "property": "operation",
        "equals": "scan"
      }
    },
    {
      "label": "Result Variable",
      "description": "Process variable to store response",
      "type": "String",
      "group": "output",
      "value": "result",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultVariable"
      }
    },
    {
      "label": "Result Expression",
      "description": "Expression to map the response into process variables",
      "type": "Text",
      "group": "output",
      "feel": "required",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultExpression"
      }
    },
    {
      "id": "errorExpression",
      "label": "Error expression",
      "description": "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
      "feel": "required",
      "type": "Text",
      "group": "errors",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      }
    },
    {
      "id": "connectionTimeout",
      "label": "Connection timeout",
      "description": "Timeout in seconds (0 for infinite)",
      "group": "retries",
      "type": "String",
      "value": "120",
      "binding": {
        "type": "zeebe:input",
        "name": "connectionTimeoutInSeconds"
      }
    },
    {
      "id": "retryCount",
      "label": "Retries",
      "description": "Number of retries",
      "value": "3",
      "feel": "optional",
      "group": "retries",
      "binding": {
        "property": "retries",
        "type": "zeebe:taskDefinition"
      },
      "type": "String"
    },
    {
      "id": "retryBackoff",
      "label": "Retry backoff",
      "description": "ISO-8601 duration to wait between retries",
      "value": "PT0S",
      "group": "retries",
      "binding": {
        "key": "retryBackoff",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    }
  ],
  "icon": {
    "contents": "data:image/png;base64,"
  }
}